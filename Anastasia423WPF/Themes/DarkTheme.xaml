<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тёмная тема. Набор ключей идентичен в LightTheme.xaml и DarkTheme.xaml. -->


    <!-- Фоны окон и страниц -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1F1B24"/>
    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF2B2431" Offset="0"/>
        <GradientStop Color="#FF5B2433" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PageBackgroundRadialBrush">
        <GradientStop Color="#FF5B2433" Offset="0"/>
        <GradientStop Color="#FF1F1B24" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuthBackgroundBrush">
        <GradientStop Color="#FF4A3B52" Offset="0"/>
        <GradientStop Color="#FF240B12" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="StartBackgroundBrush">
        <GradientStop Color="#FF4A3B52" Offset="0"/>
        <GradientStop Color="#FF1F1B24" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RegistrationBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF3B3C2C" Offset="0"/>
        <GradientStop Color="#FF0C1727" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MasterBackgroundBrush" Color="#FF2B2431"/>
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FF15121A"/>
    <SolidColorBrush x:Key="TopBarBorderBrush" Color="#FF3A3340"/>

    <!-- Поверхности: карточки, панели, содержимое -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#E6352F3C"/>
    <SolidColorBrush x:Key="CardHighlightBrush" Color="#E65A2A33"/>
    <SolidColorBrush x:Key="ItemBackgroundBrush" Color="#FF352F3C"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="PanelStrongBackgroundBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FF2A2630"/>
    <SolidColorBrush x:Key="GridBackgroundBrush" Color="#FF2F2A36"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#FF4A4553"/>

    <!-- Поля ввода -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF3F3947"/>
    <SolidColorBrush x:Key="InputWarmBackgroundBrush" Color="#FF3F3947"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FF6C6577"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFEDE6E8"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF2EAEA"/>
    <SolidColorBrush x:Key="HeadingTextBrush" Color="#FFF2B8B8"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFDCC0C0"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFE79A9A"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFB3ABB8"/>
    <SolidColorBrush x:Key="GreenTextBrush" Color="#FF7FD6A0"/>
    <SolidColorBrush x:Key="ForgotLinkBrush" Color="#FFFFB27A"/>
    <SolidColorBrush x:Key="RegisterLinkBrush" Color="#FF8AB4FF"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFB06A6A"/>
    <SolidColorBrush x:Key="ItemBorderBrush" Color="#FF5F7C99"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF55505C"/>

    <!-- Фирменные кнопки (с собственным цветом фона) -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#FF1F7A4A"/>
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#FFA64F5B"/>
    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#FF6A5C78"/>

    <!-- Кнопка по умолчанию (стиль ThemedButton) -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF48414F"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF7A7385"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFF2EAEA"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#FF5A5266"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#FFB06A6A"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#FF3A3340"/>
    <SolidColorBrush x:Key="ButtonPressedBorderBrush" Color="#FF8A5050"/>
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#FF2F2B35"/>
    <SolidColorBrush x:Key="ButtonDisabledBorderBrush" Color="#FF4A4553"/>
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#FF7E7885"/>

    <!-- Выпадающие списки (ComboBox) -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FF2F2A36"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF6C6577"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#FF4A4252"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#FF6B4660"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="#FFE0D8E4"/>

</ResourceDictionary>
