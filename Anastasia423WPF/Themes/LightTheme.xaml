<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Светлая тема. Набор ключей идентичен в LightTheme.xaml и DarkTheme.xaml. -->


    <!-- Фоны окон и страниц -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF0F0F0"/>
    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFF6CD" Offset="0"/>
        <GradientStop Color="#FFE47979" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PageBackgroundRadialBrush">
        <GradientStop Color="#FFE47979" Offset="0"/>
        <GradientStop Color="#FFFFF6CD" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuthBackgroundBrush">
        <GradientStop Color="#FFF7E693" Offset="0"/>
        <GradientStop Color="#CC7D1825" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="StartBackgroundBrush">
        <GradientStop Color="Black"/>
        <GradientStop Color="#FFEDC1DF" Offset="1"/>
        <GradientStop Color="#FFDEC49D" Offset="0"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RegistrationBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFCCCC83" Offset="0"/>
        <GradientStop Color="#FF1B375D" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MasterBackgroundBrush" Color="#FFFFF6CD"/>
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FFE9DDD3"/>
    <SolidColorBrush x:Key="TopBarBorderBrush" Color="#FFC9B5A6"/>

    <!-- Поверхности: карточки, панели, содержимое -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="CardHighlightBrush" Color="#E5FFD2D2"/>
    <SolidColorBrush x:Key="ItemBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="PanelStrongBackgroundBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GridBackgroundBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#FFF0F0F0"/>

    <!-- Поля ввода -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#B2FFFFFF"/>
    <SolidColorBrush x:Key="InputWarmBackgroundBrush" Color="#FFFFEBCD"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFABADB3"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF383131"/>
    <SolidColorBrush x:Key="HeadingTextBrush" Color="#FF6F1717"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF513030"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF803F3F"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF808080"/>
    <SolidColorBrush x:Key="GreenTextBrush" Color="#FF0F3E25"/>
    <SolidColorBrush x:Key="ForgotLinkBrush" Color="#FF802900"/>
    <SolidColorBrush x:Key="RegisterLinkBrush" Color="#FF0000FF"/>

    <!-- Рамки -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF803F3F"/>
    <SolidColorBrush x:Key="ItemBorderBrush" Color="#FFADD8E6"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FFD3D3D3"/>

    <!-- Фирменные кнопки (с собственным цветом фона) -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#FF0F3E25"/>
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#FF803F3F"/>
    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#FF383131"/>

    <!-- Кнопка по умолчанию (стиль ThemedButton) -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF707070"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#FFBEE6FD"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#FF3C7FB1"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#FFC4E5F6"/>
    <SolidColorBrush x:Key="ButtonPressedBorderBrush" Color="#FF2C628B"/>
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#FFF4F4F4"/>
    <SolidColorBrush x:Key="ButtonDisabledBorderBrush" Color="#FFADB2B5"/>
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#FF838383"/>

    <!-- Выпадающие списки (ComboBox) -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF7A7A7A"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#FFE5F3FB"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#FFCCE8FF"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF444444"/>

</ResourceDictionary>
