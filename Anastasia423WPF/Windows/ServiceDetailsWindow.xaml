<Window x:Class="Anastasia423WPF.Windows.ServiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали записи" Height="400" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="ServiceNameTxt" Text="Название услуги" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="AptDateTxt" Text="Дата: 01.01.2024" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Padding="15" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="ИНФОРМАЦИЯ О СЕАНСЕ" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#FF803F3F"/>

                <Grid Margin="0,5">
                    <TextBlock Text="Мастер:" Foreground="Gray"/>
                    <TextBlock x:Name="MasterNameTxt" Text="Имя мастера" HorizontalAlignment="Right" FontWeight="Medium"/>
                </Grid>

                <Grid Margin="0,5">
                    <TextBlock Text="Клиент:" Foreground="Gray"/>
                    <TextBlock x:Name="ClientNameTxt" Text="Имя клиента" HorizontalAlignment="Right"/>
                </Grid>

                <Separator Margin="0,15"/>

                <Grid Margin="0,5">
                    <TextBlock Text="Стоимость услуги:" FontSize="16"/>
                    <TextBlock x:Name="PriceTxt" Text="0 ₽" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,5">
                    <TextBlock Text="Статус записи:"/>
                    <TextBlock x:Name="StatusTxt" Text="Новая" HorizontalAlignment="Right" Foreground="DarkGreen"/>
                </Grid>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Content="Закрыть" Height="35" Margin="0,20,0,0" Click="Close_Click"/>
    </Grid>
</Window>