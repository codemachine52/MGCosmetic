<Window x:Class="Anastasia423WPF.Windows.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа" Height="550" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="OrderNumberTxt" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="OrderDateTxt" Foreground="Gray"/>
            <TextBlock x:Name="TotalPriceTxt" Foreground="Gray"/>
        </StackPanel>

        <ListView x:Name="OrderItemsList" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Product.Name}" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBlock Text="{Binding CountProd, StringFormat={}{0} шт.}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Product.PriceWithDiscount, StringFormat={}{0:N0} ₽}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Content="Закрыть" Grid.Row="2" Margin="0,15,0,0" Height="30" Click="Close_Click"/>
    </Grid>
</Window>