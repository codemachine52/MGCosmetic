<Window Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Windows.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Height="450" Width="500" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <StackPanel Margin="30" VerticalAlignment="Center">
            <TextBlock Text="Завершение оформления" FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Выберите способ оплаты:" Margin="0,10,0,5" FontWeight="SemiBold"/>
            <ComboBox x:Name="PaymentCombo" Height="35">
                <ComboBoxItem Content="Наличными при получении" IsSelected="True"/>
                <ComboBoxItem Content="Банковской картой"/>
                <ComboBoxItem Content="СБП (по QR-коду)"/>
            </ComboBox>

            <TextBlock Text="Удобная дата получения (в течение 7 дней):" Margin="0,15,0,5" FontWeight="SemiBold"/>
            <DatePicker x:Name="OrderDatePicker" Height="35" FirstDayOfWeek="Monday"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,10">
                <TextBlock Text="Итого к оплате: " FontSize="16"/>
                <TextBlock x:Name="TotalSumTxt" Text="0 ₽" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
            </StackPanel>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Отмена" Grid.Column="0" Margin="0,0,5,0" Height="40" 
                        Background="{DynamicResource AccentButtonBrush}" Foreground="White" Click="Cancel_Click"/>

                <Button Content="Подтвердить" Grid.Column="1" Margin="5,0,0,0" Height="40" 
                        Background="{DynamicResource PrimaryButtonBrush}" Foreground="White" FontWeight="Bold" Click="Confirm_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>