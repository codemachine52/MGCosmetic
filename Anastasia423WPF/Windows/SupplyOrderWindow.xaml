<Window Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Windows.SupplyOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ поставщику" 
        Width="450" 
        SizeToContent="Height" 
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Поставщик:" Margin="0,0,0,5"/>
            <ComboBox x:Name="SupplierBox" DisplayMemberPath="Name" Height="30"/>

            <TextBlock Text="Товар:" Margin="0,10,0,5"/>
            <ComboBox x:Name="ProductBox" DisplayMemberPath="Name" Height="30"/>

            <TextBlock Text="Количество:" Margin="0,10,0,5"/>
            <TextBox x:Name="QuantityBox" Height="30" VerticalContentAlignment="Center"/>

            <Button Style="{StaticResource ThemedButton}" Content="Добавить в заказ" Height="30" Margin="0,10,0,0" Click="AddLine_Click"/>

            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="130" Margin="0,15,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Style="{StaticResource ThemedButton}" Content="Убрать из заказа" Width="140" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0" Click="RemoveLine_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource ThemedButton}" Content="Оформить" Width="100" Height="30" Click="Save_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource ThemedButton}" Content="Отмена" Width="100" Height="30" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>