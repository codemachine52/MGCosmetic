<Window x:Class="Anastasia423WPF.Windows.DictionaryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование записи" 
        Width="400" 
        SizeToContent="Height" 
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название:" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox" Height="30" VerticalContentAlignment="Center"/>

            <StackPanel x:Name="CountryStack" Visibility="Collapsed">
                <TextBlock Text="Страна:" Margin="0,10,0,5"/>
                <TextBox x:Name="CountryBox" Height="30" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Сохранить" Width="100" Height="30" Click="Save_Click" Margin="0,0,10,0"/>
                <Button Content="Отмена" Width="100" Height="30" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>