 <Window x:Class="Anastasia423WPF.Windows.SalesReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Отчёт по продажам" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтр по периоду -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="FromPicker" Width="130"/>
            <TextBlock Text="По:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <DatePicker x:Name="ToPicker" Width="130"/>
            <Button Style="{StaticResource ThemedButton}" Content="Сформировать" Width="130" Height="30"
                    Margin="15,0,0,0" Click="Apply_Click"/>
            <Button Style="{StaticResource ThemedButton}" Content="Сбросить" Width="100" Height="30"
                    Margin="5,0,0,0" Click="Reset_Click"/>
        </StackPanel>

        <!-- Таблица + диаграмма -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="SalesGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во, шт." Binding="{Binding Quantity}"/>
                    <DataGridTextColumn Header="Выручка, руб." Binding="{Binding Revenue, StringFormat=N2}"/>
                </DataGrid.Columns>
            </DataGrid>

            <WindowsFormsHost x:Name="ChartHost" Grid.Column="1"/>
        </Grid>

        <TextBlock x:Name="TotalText" Grid.Row="2" FontSize="16" FontWeight="Bold" Margin="0,10,0,10"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ThemedButton}" Content="Экспорт в Excel" Width="150" Height="35"
                    Margin="5" Click="ExportExcel_Click"/>
            <Button Style="{StaticResource ThemedButton}" Content="Экспорт в Word" Width="150" Height="35"
                    Margin="5" Click="ExportWord_Click"/>
        </StackPanel>
    </Grid>
</Window>
