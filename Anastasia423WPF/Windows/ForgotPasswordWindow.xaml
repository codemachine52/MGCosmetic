<Window x:Class="Anastasia423WPF.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anastasia423WPF.Windows"
        mc:Ignorable="d"
        Title="ForgotPasswordWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Введите логин" FontSize="16"/>
            <TextBox x:Name="LoginText" Height="30" FontSize="14" Margin="0,10,0,0" Background="BlanchedAlmond" ToolTip="Введите логин своего аккаунта" LostFocus="LoginText_LostFocus"/>
            <TextBlock Text="Введите номер телефона" FontSize="16"/>
            <TextBox x:Name="PhoneNumberText" Height="30" FontSize="14" Margin="0,10,0,0" Background="BlanchedAlmond" ToolTip="Введите номер телефона, привязанный к аккаунту" LostFocus="PhoneNumberText_LostFocus"/>
            <TextBlock x:Name="PasswordEnterText" Margin="0,10,0,0" Text="Введите новый пароль" FontSize="16" Visibility="Collapsed"/>
            <PasswordBox x:Name="NewPasswordText" Height="30" FontSize="14" Margin="0,10,0,0" Background="BlanchedAlmond" ToolTip="Введите новый пароль" Visibility="Collapsed"/>
            <TextBlock x:Name="ConfirmPasswordEnterText" Margin="0,10,0,0" Text="Подтвердите новый пароль" Visibility="Collapsed" FontSize="16"/>
            <PasswordBox x:Name="NewPasswordConfirmText" Height="30" FontSize="14" Margin="0,10,0,0" Background="BlanchedAlmond" ToolTip="Введите новый пароль еще раз" Visibility="Collapsed"/>
        </StackPanel>
        <Button x:Name="SendRequest" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Сменить пароль" Margin="20" FontSize="16" Padding="5" Background="Black" Foreground="AntiqueWhite" Visibility="Collapsed" Click="SendRequest_Click"/>
        <Button x:Name="GoBack" HorizontalAlignment="Left" VerticalAlignment="Bottom" Content="Назад" Width="100" Margin="20" FontSize="16" Padding="5" Background="Black" Foreground="AntiqueWhite" Click="GoBack_Click"/>
    </Grid>
</Window>
