<Window x:Class="Anastasia423WPF.Windows.CaptchaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка безопасности"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Слишком много неверных попыток входа"
                       FontSize="16"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock Text="Чтобы продолжить авторизацию, решите пример и введите ответ."
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,8,0,15"/>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,15">
                <TextBlock x:Name="ExampleText"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource HeadingTextBrush}"/>
            </Border>

            <TextBox x:Name="AnswerBox"
                     Height="32"
                     FontSize="18"
                     MaxLength="6"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     ToolTip="Введите ответ на пример"
                     PreviewTextInput="AnswerBox_PreviewTextInput"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="#FFE05555"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>

            <UniformGrid Columns="2" Margin="0,20,0,0">
                <Button Content="Отмена"
                        Height="35"
                        Margin="0,0,5,0"
                        IsCancel="True"
                        Style="{StaticResource ThemedButton}"
                        Click="Cancel_Click"/>
                <Button Content="Подтвердить"
                        Height="35"
                        Margin="5,0,0,0"
                        IsDefault="True"
                        Background="{DynamicResource PrimaryButtonBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="Confirm_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
