<Window Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Windows.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Работа с товаром" Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Название товара:" />
        <TextBox x:Name="TxtName" Margin="0,5,0,10" Height="25"/>

        <TextBlock Text="Цена:" />
        <TextBox x:Name="TxtPrice" Margin="0,5,0,10" Height="25"/>

        <TextBlock Text="Скидка (%):" />
        <TextBox x:Name="TxtDiscount" Margin="0,5,0,10" Height="25"/>

        <TextBlock Text="Производитель:" />
        <ComboBox x:Name="ComboManufacturer" DisplayMemberPath="Name" SelectedValuePath="ID" Margin="0,5,0,10" Height="25"/>

        <TextBlock Text="Тип:" />
        <ComboBox x:Name="ComboType" DisplayMemberPath="Name" SelectedValuePath="ID" Margin="0,5,0,20" Height="25"/>

        <Button Content="Сохранить" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White" Height="35" Click="SaveBtn_Click"/>
    </StackPanel>
</Window>