<Window x:Class="Anastasia423WPF.Windows.AppointmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Работа с записью" Height="450" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel Margin="20">
    <TextBlock Text="Дата и время:"/>
    <DatePicker x:Name="AptDatePicker" Margin="0,5,0,10"/>
    
    <TextBlock Text="Клиент:"/>
    <ComboBox x:Name="ClientCombo" DisplayMemberPath="FIO" Margin="0,5,0,10"/>
    
    <TextBlock Text="Мастер:"/>
    <ComboBox x:Name="MasterCombo" DisplayMemberPath="FIO" Margin="0,5,0,10"/>
    
    <TextBlock Text="Услуга:"/>
    <ComboBox x:Name="ServiceCombo" DisplayMemberPath="Name" Margin="0,5,0,10"/>

    <TextBlock Text="Тип оплаты:"/>
    <ComboBox x:Name="PaymentCombo" Margin="0,5,0,10">
        <ComboBoxItem Content="Наличные"/>
        <ComboBoxItem Content="Карта"/>
    </ComboBox>

            <Button Content="Создать запись" Click="Save_Click" Padding="10" Background="#FF0F3E25" Foreground="White"/>
            <Button Content="Отмена" Margin="0,10,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>