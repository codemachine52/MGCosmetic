<Window Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Windows.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Детальная информация" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Border CornerRadius="20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" Background="{DynamicResource PageBackgroundBrush}">

        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="28" 
                       FontWeight="Thin" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,0,0,20" 
                       TextWrapping="Wrap" TextAlignment="Center"/>

            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ItemBackgroundBrush}" CornerRadius="15" Margin="0,0,20,0" Padding="10">
                <Image Source="{Binding Image}" Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Описание:" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding Description}" FontSize="16" TextWrapping="Wrap" Margin="0,5,0,15" Height="120"/>

                <TextBlock Text="{Binding Manufacturer.Name, StringFormat='Производитель: {0}'}" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding Rating, StringFormat='Рейтинг: ⭐ {0}'}" FontSize="16" Margin="0,5" Foreground="#FFB28A13"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource HeadingTextBrush}"/>
                    <TextBlock Text="{Binding Discount, StringFormat={}-{0}%}" Foreground="Red" FontSize="16" Margin="15,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Discount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CloseBtn" Content="Закрыть" Width="120" Height="35" Background="{DynamicResource AccentButtonBrush}" 
                        Foreground="White" Click="CloseBtn_Click" Margin="0,0,10,0"/>
                <Button x:Name="AddToCartBtn" Content="В корзину" Width="120" Height="35" Background="{DynamicResource PrimaryButtonBrush}" 
                        Foreground="White" Click="AddToCartBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>