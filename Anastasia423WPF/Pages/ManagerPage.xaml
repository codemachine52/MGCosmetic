<Page Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Pages.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Панель менеджера">

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <TabControl Margin="10" Background="{DynamicResource PanelBackgroundBrush}">
            <TabItem Header="Управление заказами">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                              Margin="5" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding ID}" Width="50"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding User.FIO}" Width="*"/>
                            <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Дата доставки" Binding="{Binding DelieveryDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentWay}" Width="150"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,0,5">
                        <Button Style="{StaticResource ThemedButton}" Content="Просмотреть состав" Width="150" Height="35" Margin="5" Click="ViewDetails_Click"/>
                        <Button Content="ВЫДАТЬ ЗАКАЗ" Width="150" Height="35" Margin="5" 
                                Background="{DynamicResource PrimaryButtonBrush}" Foreground="White" Click="IssueOrderBtn_Click"/>
                        <Button Style="{StaticResource ThemedButton}" Content="Отчет по продажам" Width="160" Height="35" Margin="5" Click="OpenSalesReport_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Записи на услуги">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="AppointmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата/Время" Binding="{Binding AppointmentDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding User.FIO}" Width="*"/>
                            <DataGridTextColumn Header="Услуга" Binding="{Binding Service.Name}" Width="*"/>
                            <DataGridTextColumn Header="Мастер" Binding="{Binding User1.FIO}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <Button Style="{StaticResource ThemedButton}" Content="Новая запись" Width="120" Height="35" Margin="5" Click="AddApt_Click"/>
                        <Button Style="{StaticResource ThemedButton}" Content="Перенести" Width="120" Height="35" Margin="5" Click="EditApt_Click"/>
                        <Button Style="{StaticResource ThemedButton}" Content="Отменить" Width="120" Height="35" Margin="5" Click="CancelApt_Click"/>
                        <Button Content="Удалить" Width="120" Height="35" Margin="5" Click="DeleteApt_Click" 
                                Background="{DynamicResource AccentButtonBrush}" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <Button x:Name="ExitButton" Content="К товарам" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="25" FontSize="16" Width="150"
                Background="DarkRed" Foreground="Wheat" Click="ExitButton_Click" Padding="5"/>
        <Button x:Name="ExitAccButton" Content="Выйти" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,30,25" FontSize="16" Width="150"
        Background="Crimson" Foreground="White" Click="ExitAccButton_Click" Padding="5"/>
    </Grid>
</Page>
