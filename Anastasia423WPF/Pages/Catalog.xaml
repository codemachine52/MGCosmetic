<Page x:Class="Anastasia423WPF.Pages.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="Catalog">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FFE47979"/>
                <GradientStop Color="#FFFFF6CD" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#33FFFFFF" Padding="15" Margin="20,20,20,10" CornerRadius="10">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="200" Height="30" Margin="5" Background="#B2FFFFFF" 
                         VerticalContentAlignment="Center" TextChanged="Filter_Changed" ToolTip="Поиск по названию"/>

                <ComboBox x:Name="TypeCombo" Width="180" Height="30" Margin="5" Background="#B2FFFFFF" 
                          DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>

                <ComboBox x:Name="ManufCombo" Width="180" Height="30" Margin="5" Background="#B2FFFFFF" 
                          DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>

                <ComboBox x:Name="SortCombo" Width="180" Height="30" Margin="5" Background="#B2FFFFFF" 
                          SelectionChanged="Filter_Changed"/>

                <Button x:Name="CartBtn" Content="🛒 Корзина" Width="110" Height="30" Margin="15,5,5,5" 
                        Background="#FF0F3E25" Foreground="White" FontWeight="Bold" Visibility="Collapsed" Click="CartBtn_Click"/>

                <Button x:Name="AuthUser" Width="40" Height="35" FontSize="18" Background="#FF383131" 
                        FontWeight="Thin" Foreground="White" Margin="5" Click="AuthUser_Click">👤</Button>

                <Button x:Name="AdminPanelBtn" Content="Управление" HorizontalAlignment="Right" VerticalAlignment="Top" Width="150" Height="40" Margin="10" Visibility="Collapsed" Click="AdminPanelBtn_Click"/>
            </WrapPanel>
        </Border>

        <ListView x:Name="ProductsList" Grid.Row="1" Margin="20,0,20,10" Background="Transparent" 
          BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          MouseDoubleClick="ProductsList_MouseDoubleClick"
          HorizontalContentAlignment="Center">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="230" Height="360" Margin="10" Padding="15" CornerRadius="10" BorderBrush="#FF803F3F" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#CCFFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBigDiscount}" Value="True">
                                        <Setter Property="Background" Value="#E5FFD2D2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0" Source="{Binding Image}" Stretch="Uniform" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="13" 
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#FF383131" Height="40"/>

                            <TextBlock Grid.Row="2" Text="{Binding Manufacturer.Name}" FontSize="11" 
                               Foreground="Gray" HorizontalAlignment="Center" Margin="0,5"/>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" FontSize="16" FontWeight="Bold" Foreground="#FF803F3F"/>
                                <TextBlock Text="{Binding Discount, StringFormat={} (-{0}%)}" FontSize="12" Foreground="Red" 
                                   VerticalAlignment="Bottom" Margin="5,0,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Discount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="{Binding Rating, StringFormat={}⭐ {0}}" FontSize="13" 
                               HorizontalAlignment="Center" Foreground="#FFB28A13" Margin="0,0,0,10"/>

                            <Button Grid.Row="5" Content="В корзину" VerticalAlignment="Bottom" Background="#FF0F3E25" 
                            Foreground="White" Height="30" Cursor="Hand" Click="AddToCart_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button x:Name="Back" Grid.Row="2" Width="100" Height="35" FontSize="20" Background="#FF803F3F" 
                FontWeight="Thin" Foreground="White" HorizontalAlignment="Left" Margin="30,0,0,20" Click="Back_Click">Назад</Button>
    </Grid>
</Page>