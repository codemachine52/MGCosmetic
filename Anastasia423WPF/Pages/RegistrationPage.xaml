<Page x:Class="Anastasia423WPF.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="800"
      Title="RegistrationPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFCCCC83"/>
                <GradientStop Color="#FF1B375D" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Button x:Name="Back" Width="100" Height="35" FontSize="20" Background="#FF0F3E25" FontWeight="Thin" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,30" Click="Back_Click">Назад</Button>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Padding="0,0,0,20" FontSize="36" FontWeight="Thin" Foreground="White" HorizontalAlignment="Center">Регистрация</TextBlock>

            <TextBlock FontSize="16" FontWeight="Thin" Foreground="White" Margin="0,0,0,5">Введите логин</TextBlock>
            <TextBox x:Name="LoginText" Height="30" Background="#B2FFFFFF" LostFocus="LoginText_LostFocus" ToolTip="Придумайте логин"/>
            <TextBlock x:Name="LoginError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,2,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>

            <TextBlock FontSize="16" FontWeight="Thin" Foreground="White" Margin="0,0,0,5">Введите пароль</TextBlock>
            <PasswordBox x:Name="PassText" Height="30" Background="#B2FFFFFF" LostFocus="PassText_LostFocus" ToolTip="Придумайте пароль"/>
            <TextBlock x:Name="PassError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,2,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>

            <TextBlock FontSize="16" FontWeight="Thin" Foreground="White" Margin="0,0,0,5">Подтвердите пароль</TextBlock>
            <PasswordBox x:Name="PassVerificText" Height="30" Background="#B2FFFFFF" LostFocus="PassVerificText_LostFocus" ToolTip="Введите пароль ещё раз"/>
            <TextBlock x:Name="PassVerificError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,2,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>

            <TextBlock FontSize="16" FontWeight="Thin" Foreground="White" Margin="0,0,0,5">Введите ФИО</TextBlock>
            <TextBox x:Name="FIOText" Height="30" Background="#B2FFFFFF" LostFocus="FIOText_LostFocus" ToolTip="Введите свое ФИО"/>
            <TextBlock x:Name="FIOError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,2,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>

            <TextBlock FontSize="16" FontWeight="Thin" Foreground="White" Margin="0,0,0,5">Номер телефона</TextBlock>
            <TextBox x:Name="PhoneText" Height="30" Background="#B2FFFFFF" LostFocus="PhoneText_LostFocus" ToolTip="Введите номер телефона"/>
            <TextBlock x:Name="PhoneError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,2,0,20" Visibility="Collapsed" TextWrapping="Wrap"/>

            <Button x:Name="RegistrUser" Height="40" FontSize="20" Background="#FF0F3E25" FontWeight="Thin" Foreground="White" Click="RegistrUser_Click">Зарегистрироваться</Button>
        </StackPanel>
    </Grid>
</Page>