<Page Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Pages.MainHubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главное меню: Добро пожаловать!">
    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Добро пожаловать в Косметическую Ложу МГ" FontSize="32" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,0,0,50" HorizontalAlignment="Center" FontWeight="Thin"/>

            <UniformGrid Columns="2" Width="600" Height="250">
                <Button Margin="15" Background="{DynamicResource CardBackgroundBrush}" Click="GoToShop_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🛍️" FontSize="60" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Магазин товаров" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Margin="15" Background="{DynamicResource CardBackgroundBrush}" Click="GoToServices_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="✂️" FontSize="60" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Запись на услуги" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Page>