<Page x:Class="Anastasia423WPF.Pages.MainHubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главное меню">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFFF6CD" Offset="0"/>
                <GradientStop Color="#FFE47979" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Добро пожаловать в Косметическую Ложу МГ" FontSize="32" Foreground="#FF6F1717" Margin="0,0,0,50" HorizontalAlignment="Center" FontWeight="Thin"/>

            <UniformGrid Columns="2" Width="600" Height="250">
                <Button Margin="15" Background="#CCFFFFFF" Click="GoToShop_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#FF803F3F" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🛍️" FontSize="60" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Магазин товаров" FontSize="20" FontWeight="Bold" Foreground="#FF383131" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Margin="15" Background="#CCFFFFFF" Click="GoToServices_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#FF803F3F" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="✂️" FontSize="60" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Запись на услуги" FontSize="20" FontWeight="Bold" Foreground="#FF383131" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Page>