<Page x:Class="Anastasia423WPF.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFFF6CD" Offset="0"/>
                <GradientStop Color="#FFE47979" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Margin="10" Background="Transparent" BorderThickness="0">
            <TabItem Header="Товары" FontSize="14" Padding="10,5">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price}"/>
                            <DataGridTextColumn Header="Скидка" Binding="{Binding Discount}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="Добавить" Width="100" Margin="5" Click="AddProduct_Click"/>
                        <Button Content="Редактировать" Width="120" Margin="5" Click="EditProduct_Click"/>
                        <Button Content="Удалить" Width="100" Margin="5" Background="#8B0000" Foreground="White" Click="DeleteProduct_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Производители" FontSize="14" Padding="10,5">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ManufacturersGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Страна производителя" Binding="{Binding Country}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="Добавить" Width="100" Margin="5" Click="AddManufacturer_Click"/>
                        <Button Content="Редактировать" Width="120" Margin="5" Click="EditManufacturer_Click"/>
                        <Button x:Name="DeleteManufacturerBtn" Content="Удалить" Width="100" Margin="5" Background="#8B0000" Foreground="White" Click="DeleteManufacturer_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Типы" FontSize="14" Padding="10,5">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="TypesGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}"/>
                            <DataGridTextColumn Header="Название типа" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="Добавить" Width="100" Margin="5" Click="AddType_Click"/>
                        <Button Content="Редактировать" Width="120" Margin="5" Click="EditType_Click"/>
                        <Button x:Name="DeleteTypeBtn" Content="Удалить" Width="100" Margin="5" Background="#8B0000" Foreground="White" Click="DeleteType_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="UsersTab" Header="Пользователи" FontSize="14" Padding="10,5">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Роль" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AllRoles, RelativeSource={RelativeSource AncestorType=Page}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="ID"
                                                  SelectedValue="{Binding RoleID, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="RoleCombo_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="Изменить статус" Width="140" Margin="5" Click="ChangeUserStatus_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1" Content="Назад к записям" Width="150" Height="35" HorizontalAlignment="Left" Margin="15" Click="Back_Click"/>
    </Grid>
</Page>