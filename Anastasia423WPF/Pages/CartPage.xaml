<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Anastasia423WPF.Pages.CartPage"
      Title="Корзина" av:DesignHeight="650" av:DesignWidth="600">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FFE47979"/>
                <GradientStop Color="#FFFFF6CD" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ваша корзина" FontSize="28" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="20" Foreground="#FF383131"/>

        <ListView x:Name="CartList" Grid.Row="1" Margin="20,0" Background="#33FFFFFF" 
                  BorderThickness="0" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10" Margin="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Image}" Height="60" Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" Foreground="#FF803F3F" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="-" Width="30" Height="30" Click="MinusBtn_Click" 
                                        Background="#FF803F3F" Foreground="White" FontWeight="Bold"/>

                                <TextBlock Text="{Binding CountProd}" FontSize="18" Width="40" 
                                           TextAlignment="Center" VerticalAlignment="Center"/>

                                <Button Content="+" Width="30" Height="30" Click="PlusBtn_Click" 
                                        Background="#FF0F3E25" Foreground="White" FontWeight="Bold"/>

                                <Button Content="🗑 Удалить" Margin="20,0,0,0" Padding="10,0" Height="30" 
                                        Background="Transparent" BorderBrush="Red" Foreground="Red" 
                                        Click="RemoveBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="2" Background="#33FFFFFF" Margin="20,10">
            <Grid>
                <Button Content="Назад" HorizontalAlignment="Left" Width="120" Height="40" 
                        Margin="20,0" Click="Back_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Итого: " FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalSumText" Text="0 ₽" FontSize="26" FontWeight="Bold" 
                               Foreground="#FF803F3F" VerticalAlignment="Center" Margin="10,0,30,0"/>

                    <Button x:Name="OrderBtn" Content="ОФОРМИТЬ ЗАКАЗ" Width="200" Height="50" 
                            Background="#FF0F3E25" Foreground="White" FontWeight="Bold" FontSize="16" 
                            Click="Order_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>