<Page Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница авторизации">

    <Grid Background="{DynamicResource AuthBackgroundBrush}">
        <Button x:Name="Back" Width="150" Height="35" FontSize="20" Background="{DynamicResource AccentButtonBrush}" FontWeight="Thin" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,30" Click="Back_Click">В каталог</Button>
        <Button x:Name="Enter" Width="150" Height="35" FontSize="20" Background="#FFF7E693" FontWeight="SemiBold"  Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" Click="Enter_Click">Войти</Button>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Padding="20" FontSize="36" FontWeight="Thin"  Foreground="White">Войдите в аккаунт</TextBlock>
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,15" FontSize="20" FontWeight="Thin"  Foreground="White" >Введите логин</TextBlock>
            <TextBox x:Name="LoginText"  Width="140" Height="30" Background="{DynamicResource InputBackgroundBrush}" ToolTip="Введите логин"></TextBox>
            <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="20" FontWeight="Thin"  Foreground="White">Введите пароль</TextBlock>
            <PasswordBox x:Name="PassText" Width="140" Height="30" Background="{DynamicResource InputBackgroundBrush}" Margin="0,15,0,0" ToolTip="Введите пароль"></PasswordBox>
            <Button x:Name="Forgot" Width="200" Margin="0,20,0,0" Foreground="{DynamicResource ForgotLinkBrush}" Background="Transparent" FontWeight="DemiBold" FontSize="16" FontFamily="Arial Black" Click="Forgot_Click">Забыли пароль?</Button>
            <TextBlock  HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="18" FontWeight="Thin"  Foreground="White">Нет аккаунта?</TextBlock>
            <Button x:Name="Registr"  Width="200"  Foreground="{DynamicResource RegisterLinkBrush}" Background="Transparent" FontWeight="DemiBold" FontSize="16" FontFamily="Arial Black" Click="Registr_Click">Зарегистрируйтесь</Button>
            
        </StackPanel>
    </Grid>
</Page>
