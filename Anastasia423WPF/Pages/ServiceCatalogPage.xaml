<Page Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Pages.ServiceCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Наши услуги">
    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <ListView x:Name="ServicesList" Margin="20" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}" CornerRadius="10" Margin="0,5" Padding="15">
                        <Grid Width="700">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0} ₽}" VerticalAlignment="Center" FontSize="18" Margin="20,0"/>

                            <Button Grid.Column="2" Content="Записаться" Padding="10,5" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White" Click="Book_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="Back" Grid.Row="2" Width="100" Height="35" FontSize="20" Background="{DynamicResource AccentButtonBrush}" 
FontWeight="Thin" Foreground="White" HorizontalAlignment="Left" Margin="30,0,0,20" Click="Back_Click" VerticalAlignment="Bottom">Назад</Button>

    </Grid>
</Page>