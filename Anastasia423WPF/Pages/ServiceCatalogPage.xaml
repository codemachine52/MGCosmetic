<Page x:Class="Anastasia423WPF.Pages.ServiceCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Наши услуги">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFFF6CD" Offset="0"/>
                <GradientStop Color="#FFE47979" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ListView x:Name="ServicesList" Margin="20" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#CCFFFFFF" CornerRadius="10" Margin="0,5" Padding="15">
                        <Grid Width="700">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0} ₽}" VerticalAlignment="Center" FontSize="18" Margin="20,0"/>

                            <Button Grid.Column="2" Content="Записаться" Padding="10,5" Background="#FF0F3E25" Foreground="White" Click="Book_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="Back" Grid.Row="2" Width="100" Height="35" FontSize="20" Background="#FF803F3F" 
FontWeight="Thin" Foreground="White" HorizontalAlignment="Left" Margin="30,0,0,20" Click="Back_Click" VerticalAlignment="Bottom">Назад</Button>

    </Grid>
</Page>