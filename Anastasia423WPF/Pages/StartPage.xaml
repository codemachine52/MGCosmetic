<Page Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Anastasia423WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Приветственная страница">

    <Grid Background="{DynamicResource StartBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="Title" FontSize="36" FontWeight="Thin"  Foreground="{DynamicResource HeadingTextBrush}">Салон красоты MG</TextBlock>
            <Button x:Name="LoginButton" Background="#FFECDA87" FontSize="22" Margin="0,40,0,0" Foreground="#FF6F1717" Padding="10" Click="LoginButton_Click">Вход</Button>
        </StackPanel>
    </Grid>
</Page>
