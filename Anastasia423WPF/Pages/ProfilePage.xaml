<Page Foreground="{DynamicResource TextBrush}" x:Class="Anastasia423WPF.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30" MaxWidth="800">
                <Border Background="{DynamicResource PanelStrongBackgroundBrush}" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="80" Height="80" Fill="{DynamicResource AccentButtonBrush}" />

                        <StackPanel Grid.Column="1" Margin="20,0">
                            <TextBlock Text="{Binding FIO}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding RoleName, StringFormat='Статус: {0}'}" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding Phone, StringFormat='Тел: {0}'}" FontSize="14" Margin="0,5"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Выйти" Click="Logout_Click" Width="150" Height="35" Background="{DynamicResource AccentButtonBrush}" Foreground="White"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="OrderHistoryText" Text="История заказов" FontSize="20" FontWeight="Bold" Margin="0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ListView x:Name="OrdersList" Height="250" Background="Transparent" BorderThickness="0" MouseDoubleClick="OrdersList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}" CornerRadius="10" Margin="0,5" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding OrderDate, StringFormat='{}Заказ от {0:dd.MM.yyyy}'}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Подробнее" Foreground="{DynamicResource AccentTextBrush}" Cursor="Hand" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Записи на услуги" FontSize="20" FontWeight="Bold" Margin="0,20,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ListView x:Name="AppointmentsList" Height="250" Background="Transparent" BorderThickness="0" MouseDoubleClick="AppointmentsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}" CornerRadius="10" Margin="0,5" Padding="15">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Service.Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AppointmentDate, StringFormat='{}Дата: {0:dd.MM.yyyy} Время: {0:HH:mm}'}" FontSize="12"/>
                                        <TextBlock Text="{Binding User1.FIO, StringFormat='Мастер: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Content="Вернуться в каталог" Click="Back_Click" Margin="0,20,0,20" Height="40" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>