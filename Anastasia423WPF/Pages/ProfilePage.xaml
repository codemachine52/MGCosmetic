<Page x:Class="Anastasia423WPF.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFFF6CD" Offset="0"/>
                <GradientStop Color="#FFE47979" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30" MaxWidth="800">
                <Border Background="#66FFFFFF" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="80" Height="80" Fill="#FF803F3F" />

                        <StackPanel Grid.Column="1" Margin="20,0">
                            <TextBlock Text="{Binding FIO}" FontSize="24" FontWeight="Bold" Foreground="#FF383131"/>
                            <TextBlock Text="{Binding RoleName, StringFormat='Статус: {0}'}" FontSize="16" Foreground="#FF513030"/>
                            <TextBlock Text="{Binding Phone, StringFormat='Тел: {0}'}" FontSize="14" Margin="0,5"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Выйти" Click="Logout_Click" Width="100" Height="30" Background="#FF803F3F" Foreground="White"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="OrderHistoryText" Text="История заказов" FontSize="20" FontWeight="Bold" Margin="0,10" Foreground="#FF383131"/>
                <ListView x:Name="OrdersList" Height="250" Background="Transparent" BorderThickness="0" MouseDoubleClick="OrdersList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#CCFFFFFF" CornerRadius="10" Margin="0,5" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding OrderDate, StringFormat='{}Заказ от {0:dd.MM.yyyy}'}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Подробнее" Foreground="#FF803F3F" Cursor="Hand" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Записи на услуги" FontSize="20" FontWeight="Bold" Margin="0,20,0,10" Foreground="#FF383131"/>
                <ListView x:Name="AppointmentsList" Height="250" Background="Transparent" BorderThickness="0" MouseDoubleClick="AppointmentsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#CCFFFFFF" CornerRadius="10" Margin="0,5" Padding="15">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Service.Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AppointmentDate, StringFormat='{}Дата: {0:dd.MM.yyyy} Время: {0:HH:mm}'}" FontSize="12"/>
                                        <TextBlock Text="{Binding User1.FIO, StringFormat='Мастер: {0}'}" FontSize="12" Foreground="#FF513030"/>
                                        <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Content="Вернуться в каталог" Click="Back_Click" Margin="0,20,0,20" Height="40" Background="#FF0F3E25" Foreground="White"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>